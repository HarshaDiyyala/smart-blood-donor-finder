# Set MYSQL_DATABASE to enable MySQL. Leave it empty for the local SQLite fallback.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_blood_donor

# Optional Firestore mirror. Keep service-account JSON outside the repository.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Leave blank to use Google Application Default Credentials instead.
FIREBASE_SERVICE_ACCOUNT=